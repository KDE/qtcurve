#~ msgid "Use Custom Shades"
#~ msgstr "Použiť vlastné tiene"

#~ msgid ""
#~ "<i><p>QtCurve uses various hard-coded shading values to draw elements "
#~ "such as button frames, the background for pressed buttons, etc. The "
#~ "following is a brief overview of how each shade is used - use this as a "
#~ "guide only, as shades are used for various things.</p>\n"
#~ "<p><ol>\n"
#~ "<li>Is used for the light part of 3d elements - such as the border of tab "
#~ "widgets.</li>\n"
#~ "<li>Is used for the lighter shade of striped progressbars.</li>\n"
#~ "<li>Is used for the dark part of 3d elements - such as the border of tab "
#~ "widgets.</li>\n"
#~ "<li>Is used for the shaded border of checks and radios, toolbar borders "
#~ "(when set to dark), the dark part of sunken/raised slider handles, etc.</"
#~ "li>\n"
#~ "<li>Is used for the background of pressed widgets, and the border of "
#~ "toolbars (when not dark).</li>\n"
#~ "<li>Is used as the border of most widgets.</li>\n"
#~ "</ol></p></i>"
#~ msgstr ""
#~ "<i><p>QtCurve používa rôzne pevne zakódované hodnoty tieňovania na "
#~ "kreslenie prvkov ako rámce tlačidiel, pozadie stlačených tlačidiel atď. "
#~ "Nasleduje stručný prehľad ako sa každý odtieň používa - použite to iba "
#~ "ako návod, pretože odtiene sa používajú na rôzne veci.</p>\n"
#~ "<p><ol>\n"
#~ "<li>Používa sa pre svetlú časť 3D prvkov - ako okraj widgetov kariet.</"
#~ "li>\n"
#~ "<li>Používa sa pre svetlejší odtieň pruhovaných indikátorov priebehu.</"
#~ "li>\n"
#~ "<li>Používa sa pre tmavú časť 3D prvkov - ako okraj widgetov kariet.</"
#~ "li>\n"
#~ "<li>Používa sa pre tieňovaný okraj zaškrtávacích a prepínacích polí, "
#~ "okraje panelov nástrojov (keď sú nastavené na tmavé), tmavú časť "
#~ "zapustených/zdvihnutých úchytiek posuvníkov atď.</li>\n"
#~ "<li>Používa sa pre pozadie stlačených widgetov a okraj panelov nástrojov "
#~ "(keď nie sú tmavé).</li>\n"
#~ "<li>Používa sa ako okraj väčšiny widgetov.</li>\n"
#~ "</ol></p></i>"

