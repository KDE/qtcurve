msgstr "Aktívne okná:"

#. i18n: ectx: property (text), widget (QLabel, label_58)
#: qt4/config/qtcurveconfigbase.ui:2972 qt5/config/qtcurveconfigbase.ui:3053
#: qt6/config/qtcurveconfigbase.ui:3053
#, kde-format
msgid "Menubar text:"
