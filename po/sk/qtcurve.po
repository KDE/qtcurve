#~ msgstr "Použiť vlastné hodnoty alfa"

#~ msgid "Light:"
#~ msgstr "Svetlo"

#~ msgid ""
#~ "<p><i>QtCurve uses dark/light borders to create etch and shadow effects. "
#~ "By default QtCurve tries to lighten (or darken) the parent's background "
#~ "to achieve this - if no parent can be found, then white/black is used "
#~ "with an alpha value set. This behaviour may be overridden, and alpha "
#~ "values always used, by checking the option above.</i></p>"
#~ msgstr ""
#~ "<p><i>QtCurve používa tmavé/svetlé okraje na vytvorenie efektov leptania "
#~ "a tieňov. V predvolenom nastavení sa QtCurve pokúša zosvetliť (alebo "
#~ "stmaviť) pozadie rodiča na dosiahnutie tohto efektu - ak sa rodič "
#~ "nenájde, použije sa biela/čierna s nastavenou hodnotou alfa. Toto "
#~ "správanie je možné prepísať a vždy používať hodnoty alfa zaškrtnutím "
#~ "voľby vyššie.</i></p>"

